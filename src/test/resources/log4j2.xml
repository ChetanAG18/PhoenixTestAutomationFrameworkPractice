<configuration status = "warn">

	<appenders>
		<console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d [%t] %highlight{%5p} %c::%M():%L - %m%n"></PatternLayout>
		</console>
	</appenders>
		
	<loggers>
		<root level = "INFO">
			<AppenderRef ref="Console"></AppenderRef>
		</root>	
	</loggers>

</configuration>